#!/usr/bin/env bash
# piclaude — drive Claude Code on an isolated Pijul workspace, then validate
# and record the patches it builds.
#
#   piclaude [new] [--task "…"] [name] [claude args…]  fork the repo and launch
#                             `claude` in it; --task slugifies into the fork name
#                             AND becomes claude's opening prompt; trailing args
#                             go to claude (e.g. --resume ID)
#   piclaude fork [name]      fork only, print the workspace path (no launch)
#   piclaude save -m MSG [-d DESC] FILE...   record ONLY the named files in the
#                             current workspace (no review); -d sets the separate
#                             description field
#   piclaude carve [FILE...]  review/record pending work through the real Pijul
#                             editor (Saveur 1); adapts to GUI or TTY editors
#   piclaude land [--amend] -m MSG [-d DESC] FILE...  (in a fork) record ONLY the
#                             named files, then under a land lock pull MAIN into the
#                             fork and push back — so main stays buildable. On
#                             conflict it stops and asks you to resolve in the fork
#                             and re-run (land is re-runnable). --amend fixes the
#                             last change; -d sets the description
#   piclaude integrate [DIR…] pull agent workspaces back into the current repo
#   piclaude status           dashboard of every fork: agent state (waiting/ready/
#                             running) + pending diff + changes ahead of main
#   piclaude doctor           show which pijul is used and editor capabilities
#
# The carve *decomposition* (splitting the pile into logical changes) is done
# by Claude via the `piclaude-carve` skill, using `pijul record --from-change`.
# This script is the plumbing: fork, launch, the editor escape hatch, integrate.
set -euo pipefail

# Uses `pijul` from PATH; it must support `record --from-change` (the carve
# patch). Pin a specific binary with PICLAUDE_PIJUL if it's not on your PATH.
resolve_pijul() {
  local c
  for c in "${PICLAUDE_PIJUL:-}" "$(command -v pijul 2>/dev/null || true)"; do
    [ -n "$c" ] && [ -x "$c" ] || continue
    if "$c" record --help 2>/dev/null | grep -q -- '--from-change'; then
      printf '%s' "$c"; return 0
    fi
  done
  echo "piclaude: the pijul on PATH doesn't support 'record --from-change'." >&2
  echo "          install the patched pijul, or set PICLAUDE_PIJUL." >&2
  return 1
}

repo_root() {
  local r=$PWD
  while [ "$r" != / ] && [ ! -d "$r/.pijul" ]; do r=$(dirname "$r"); done
  [ -d "$r/.pijul" ] || { echo "piclaude: not inside a Pijul repo" >&2; return 1; }
  printf '%s' "$r"
}

# Can we open an interactive editor from *here* (this process)?
#  - a GUI editor needs a display, not a TTY (Claude's Bash tool can drive it);
#  - a terminal editor needs a controlling TTY.
can_edit_here() {
  [ -n "${VISUAL:-${EDITOR:-}}" ] || return 1
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && return 0   # GUI editor
  [ -t 0 ] && [ -t 1 ] && return 0                        # terminal editor
  return 1
}

fork_repo() {
  local root=$1 name=$2
  local parent="$(dirname "$root")/$(basename "$root").agents"
  mkdir -p "$parent"
  if [ -z "$name" ]; then
    local i=1; while [ -e "$parent/w$i" ]; do i=$((i+1)); done; name="w$i"
  fi
  local dest="$parent/$name"
  [ -e "$dest" ] && { echo "piclaude: $dest already exists" >&2; return 1; }
  if cp --reflink=always -a "$root" "$dest" 2>/dev/null; then
    echo "piclaude: forked $name (reflink CoW, target/ chaud)" >&2
  else
    rm -rf "$dest"; cp -a "$root" "$dest"
    echo "piclaude: forked $name (full copy — FS sans reflink)" >&2
  fi
  printf '%s' "$dest"
}

# Rust-specific: if a shared cargo target dir is configured via
# CARGO_BUILD_TARGET_DIR, give this fork its own btrfs/xfs CoW copy of it and
# repoint the variable, so the fork can build without colliding with other forks
# (Rust is the one toolchain we've seen share a target cache safely). Idempotent:
# a re-entered workspace reuses its copy (warm cache). On a non-reflink FS it
# leaves the shared dir untouched. Disable with PICLAUDE_NO_FORK_TARGET=1.
fork_cargo_target() {
  local dest=$1 src=${CARGO_BUILD_TARGET_DIR:-}
  [ -z "${PICLAUDE_NO_FORK_TARGET:-}" ] || return 0
  [ -n "$src" ] && [ -d "$src" ] || return 0
  local dst="$src.agents/$(basename "$dest")"
  if [ ! -d "$dst" ]; then
    mkdir -p "$(dirname "$dst")"
    if ! cp --reflink=always -a "$src" "$dst" 2>/dev/null; then
      rm -rf "$dst"
      echo "piclaude: cargo target non-CoW, gardé partagé ($src)" >&2
      return 0
    fi
  fi
  export CARGO_BUILD_TARGET_DIR="$dst"
  echo "piclaude: cargo target -> $dst (CoW isolé, build dans le fork OK)" >&2
}

# Turn a free-form task line into a fork name: lowercase, non-alphanumerics
# collapsed to single dashes, trimmed, capped. Empty result → caller falls back
# to the auto w-N numbering.
slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' \
    | sed 's/^-*//; s/-*$//' | cut -c1-40
}

cmd_new() {
  local name="" task="" pijul root dest
  # Optional leading `--task "…"` (or -t): its slug becomes the workspace name
  # (unless you also pass an explicit name) AND it's handed to claude as the
  # session's opening prompt — so one line names the fork and briefs the agent.
  while [ $# -gt 0 ]; do
    case "$1" in --task|-t) task=$2; shift 2 ;; *) break ;; esac
  done
  # Optional leading workspace name = the first arg that isn't a flag.
  # Everything else is forwarded to `claude` (e.g. --resume ID, --model …).
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ] && [ "$1" != "--" ]; then name=$1; shift; fi
  [ "${1:-}" = "--" ] && shift        # optional explicit separator
  [ -z "$name" ] && [ -n "$task" ] && name=$(slugify "$task")
  pijul=$(resolve_pijul)              # verify PATH's pijul has --from-change
  root=$(repo_root)
  # Named workspace that already exists → re-enter it (e.g. to `claude --resume`
  # a killed session), instead of erroring on a re-fork. New/unnamed → fork.
  local parent="$(dirname "$root")/$(basename "$root").agents"
  if [ -n "$name" ] && [ -d "$parent/$name/.pijul" ]; then
    dest="$parent/$name"
    echo "piclaude: re-entering existing workspace $name (not re-forking)" >&2
  else
    dest=$(fork_repo "$root" "$name")
  fi
  echo "piclaude: launching Claude in $dest${*:+ (claude $*)}" >&2
  cd "$dest"
  # Trust PATH; only adjust it if a binary was pinned off-PATH.
  [ -n "${PICLAUDE_PIJUL:-}" ] && PATH="$(dirname "$pijul"):$PATH"
  fork_cargo_target "$dest"           # per-fork CoW cargo target (if configured)

  # Assemble Claude's launch flags. Claude derives its window title from the
  # session name, so name the session after the fork — native and not overwritten
  # (unlike a raw OSC escape, which Claude replaces). Skip --name on
  # resume/continue (the session keeps its own name) and when PICLAUDE_NO_TITLE=1.
  local extra=() a resuming=0
  for a in "$@"; do case "$a" in -r|--resume|-c|--continue) resuming=1 ;; esac; done
  if [ "$resuming" -eq 0 ] && [ -z "${PICLAUDE_NO_TITLE:-}" ]; then
    extra+=(--name "piclaude $(basename "$dest")")
  fi

  # Light brief so the agent knows where it is and how work leaves the fork.
  # The prompt text lives in piclaude-brief.md (next to this script) so the
  # pijul/claude VS Code extension can share the exact same wording; here we
  # just fill in the two workspace paths. Disable with PICLAUDE_NO_BRIEF=1.
  if [ -z "${PICLAUDE_NO_BRIEF:-}" ]; then
    local brief brieffile
    brieffile="$(dirname "$(readlink -f "$0")")/piclaude-brief.md"
    if [ -f "$brieffile" ]; then
      brief=$(< "$brieffile")
      brief=${brief//\{\{WORKSPACE\}\}/$dest}   # pure-bash substitution: no
      brief=${brief//\{\{MAIN_REPO\}\}/$root}   # sed-escaping of the paths
      extra+=(--append-system-prompt "$brief")
    else
      echo "piclaude: brief not found ($brieffile), launching without it" >&2
    fi
  fi

  # Hooks, injected in ONE additive --settings payload (nothing written to the
  # repo). Single quotes group each hook's shell args; they're valid inside a
  # JSON string (only " and \ need escaping, and our paths have neither).
  #   • PreToolUse guard (PICLAUDE_NO_GUARD=1 to skip): refuses Edit/Write/… under
  #     the MAIN repo, so the agent reaches main only through `piclaude land`.
  #   • UserPromptSubmit/Stop/Notification (PICLAUDE_NO_STATUS=1 to skip): record
  #     the agent's state for `piclaude status` and ping you when it needs you.
  local scriptdir hooks_parts=()
  scriptdir="$(dirname "$(readlink -f "$0")")"
  if [ -z "${PICLAUDE_NO_GUARD:-}" ]; then
    local guard="$scriptdir/piclaude-guard-main.sh"
    if [ -x "$guard" ]; then
      hooks_parts+=("\"PreToolUse\":[{\"matcher\":\"Edit|Write|MultiEdit|NotebookEdit\",\"hooks\":[{\"type\":\"command\",\"command\":\"'$guard' '$root' '$dest'\"}]}]")
    else
      echo "piclaude: guard not executable ($guard), launching without it" >&2
    fi
  fi
  if [ -z "${PICLAUDE_NO_STATUS:-}" ]; then
    local notify="$scriptdir/piclaude-notify.sh" ev st
    if [ -x "$notify" ]; then
      # event → state: prompt sent = running, turn done = ready, attention = waiting
      for ev in "UserPromptSubmit:running" "Stop:ready" "Notification:waiting"; do
        st=${ev#*:}; ev=${ev%:*}
        hooks_parts+=("\"$ev\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"'$notify' '$dest' $st\"}]}]")
      done
    else
      echo "piclaude: notify hook not executable ($notify), no status/pings" >&2
    fi
  fi
  if [ ${#hooks_parts[@]} -gt 0 ]; then
    local joined; joined=$(IFS=,; echo "${hooks_parts[*]}")
    extra+=(--settings "{\"hooks\":{$joined}}")
  fi

  # A --task line doubles as claude's opening prompt (a bare positional). Skip on
  # resume/continue (the session already has its history). Goes last so it can't
  # be mistaken for a flag value.
  local prompt=()
  if [ -n "$task" ] && [ "$resuming" -eq 0 ]; then prompt=("$task"); fi

  exec claude ${extra[@]+"${extra[@]}"} "$@" ${prompt[@]+"${prompt[@]}"}
}

cmd_fork() {
  local root; root=$(repo_root)
  fork_repo "$root" "${1:-}"          # prints the workspace path to stdout
}

cmd_save() {
  local pijul; pijul=$(resolve_pijul); repo_root >/dev/null
  # Flags in any order: -m/--message MSG (the one-line subject), -d/--description
  # BODY (Pijul's separate `description` field). Everything after the flags is the
  # FILE LIST — we record ONLY those files, so stray untracked churn (build
  # artifacts, editor autosaves, secrets) can never be swept into history.
  local -a dopt=(); local msg="" have_msg=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--message)      msg=$2; have_msg=1; shift 2 ;;
      -d|--description)  dopt=(--description "$2"); shift 2 ;;
      --)                shift; break ;;
      -*)                echo "piclaude save: unknown flag $1" >&2; return 2 ;;
      *)                 break ;;
    esac
  done
  local -a files=("$@")
  [ "$have_msg" -eq 1 ] || { echo "usage: piclaude save -m MESSAGE [-d DESCRIPTION] file..." >&2; return 2; }
  [ ${#files[@]} -ge 1 ] || { echo "piclaude save: name the file(s) to record — never a bare recursive add" >&2; return 2; }
  # Track any not-yet-tracked NAMED files (never `add --recursive .`, which would
  # pull the whole untracked tree in), then record only those paths.
  "$pijul" add "${files[@]}"
  "$pijul" record --all --message "$msg" ${dopt[@]+"${dopt[@]}"} "${files[@]}"
}

cmd_carve() {
  local pijul; pijul=$(resolve_pijul)
  repo_root >/dev/null
  if ! can_edit_here; then
    echo "piclaude carve: no interactive editor usable here." >&2
    echo "  • GUI editor: set VISUAL (e.g. 'emacsclient -c') and a display, or" >&2
    echo "  • run it from your terminal:  ! piclaude carve" >&2
    return 1
  fi
  if [ $# -eq 0 ]; then
    # Manual carve: the real Pijul editor opens on the whole pending diff.
    exec "$pijul" record
  fi
  # Claude prepared per-group change files: open each in the editor for a final
  # tweak, then record it. The file's message is kept (see --from-change).
  local f
  for f in "$@"; do
    "${VISUAL:-$EDITOR}" "$f"
    "$pijul" record --from-change "$f"
  done
}

cmd_land() {
  # From inside a fork, the ONLY sanctioned way to write to main:
  #   1. record the change in the fork (`pijul record`, `--amend` to revise the
  #      last one) — main is never hand-edited;
  #   2. under a land lock: pull main INTO the fork, then push the fork to main.
  # We DO pull main first now (was dropped 2026-08-05, restored 2026-08-08): for a
  # conflicting land someone must pull-and-resolve before the change reaches main
  # (push is commutative — if two forks edit the same lines, main gets the conflict
  # whatever the order), so main stays buildable. Doing that pull in THIS fork also
  # keeps it current with siblings' landed work — useful when agents touch the same
  # code or use each other's features. The churn/"someone edits my fork" pain of
  # the old design is tamed three ways: the pull is a no-op when main has nothing
  # new (the arbre doesn't move), it happens at a deliberate moment (just after a
  # record, clean tree) and is announced, and a flock serialises lands so there's
  # no race between pull and push.
  local pijul fork agentsdir main
  pijul=$(resolve_pijul)
  fork=$(repo_root) || return 1
  agentsdir=$(dirname "$fork")
  case "$agentsdir" in
    *.agents) : ;;
    *) echo "piclaude land: not inside a piclaude fork (.../<repo>.agents/<name>)" >&2; return 1 ;;
  esac
  main="${agentsdir%.agents}"
  [ -d "$main/.pijul" ] || { echo "piclaude land: main repo not found at $main" >&2; return 1; }

  # Flags in any order: --amend, -m/--message MSG (the one-line subject),
  # -d/--description BODY (Pijul's separate `description` field). Everything after
  # the flags is the FILE LIST — land records ONLY those files, so stray untracked
  # churn (build artifacts, editor autosaves, secrets) can never be swept in.
  local amend=0 msg="" have_msg=0; local -a dopt=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --amend)           amend=1; shift ;;
      -m|--message)      msg=$2; have_msg=1; shift 2 ;;
      -d|--description)  dopt=(--description "$2"); shift 2 ;;
      --)                shift; break ;;
      -*)                echo "piclaude land: unknown flag $1" >&2; return 2 ;;
      *)                 break ;;
    esac
  done
  local -a files=("$@")

  # 1. Record in the fork (local, no main contention — before the lock). Always
  # scoped to the NAMED files: `record --all <files>` records only those paths;
  # `record --all` with NO paths would record every tracked change. And we never
  # `add --recursive .` — only the named files get tracked.
  if [ "$amend" -eq 1 ]; then
    # Amend needs the file list too, else it re-scans the whole pending tree into
    # the superseding change. No `pijul add` here: re-adding tracked paths injects
    # a spurious extra dependency that breaks the supersede — add any brand-new
    # file explicitly before `land --amend`.
    [ ${#files[@]} -ge 1 ] || { echo "piclaude land --amend: name the file(s) to amend" >&2; return 2; }
    if [ "$have_msg" -eq 1 ]; then "$pijul" record --all --amend --message "$msg" ${dopt[@]+"${dopt[@]}"} "${files[@]}"
    else                          "$pijul" record --all --amend ${dopt[@]+"${dopt[@]}"} "${files[@]}"; fi
  elif [ "$have_msg" -eq 1 ] || [ ${#files[@]} -ge 1 ]; then
    [ "$have_msg" -eq 1 ] || { echo "piclaude land: give a message with -m \"…\"" >&2; return 2; }
    [ ${#files[@]} -ge 1 ] || { echo "piclaude land: name the file(s) to land — never a bare recursive add" >&2; return 2; }
    "$pijul" add "${files[@]}"
    "$pijul" record --all --message "$msg" ${dopt[@]+"${dopt[@]}"} "${files[@]}"
  fi

  # Run a pijul op, retrying while the target's *pristine* is locked (Pijul's
  # internal lock, e.g. a concurrent `integrate` — distinct from our land lock).
  _pijul_retry() {
    local tries=0 out
    while :; do
      if out=$("$pijul" "$@" 2>&1); then [ -n "$out" ] && echo "$out"; return 0; fi
      if printf '%s' "$out" | grep -qi lock; then
        tries=$((tries+1)); [ "$tries" -ge 200 ] && { echo "give up (locked)" >&2; return 1; }
        sleep 0.05; continue
      fi
      echo "$out" >&2; return 1
    done
  }

  # 2. Serialise the whole land against other forks with an flock on main. Held
  # from before the pull until the process exits (after push) — so no other fork
  # can land in the pull→push window and reopen a conflict on main.
  local lockfd
  exec {lockfd}>"$main/.pijul/piclaude-land.lock"
  flock "$lockfd"

  # 2a. Pull main -> fork. --all skips the changelist editor; --no-notify skips
  # the remote-unrecord editor (both would block an agent). A no-op when main has
  # nothing new. Pijul reports conflicts as "There were conflicts:" on stderr but
  # still exits 0, so we inspect the captured output rather than the exit code.
  echo "piclaude land: pull $main -> $(basename "$fork")" >&2
  local pullout
  pullout=$(_pijul_retry pull --all --no-notify "$main") || { echo "$pullout" >&2; return 1; }
  [ -n "$pullout" ] && echo "$pullout"          # announce what moved (or "Nothing to pull")

  if printf '%s\n' "$pullout" | grep -q "There were conflicts:"; then
    flock -u "$lockfd"    # release now — resolution can take a while; don't block others
    echo "" >&2
    echo "  >>> CONFLIT en tirant main dans le fork ($(basename "$fork"))." >&2
    echo "  >>> Résous les marqueurs ici, puis relance en NOMMANT les fichiers résolus:" >&2
    echo "  >>>   piclaude land -m \"resolve\" fichier-resolu…" >&2
    echo "  >>> (le record ramasse la résolution des fichiers nommés ; main n'aura alors" >&2
    echo "  >>>  plus rien à tirer, donc push direct. Le land est ré-exécutable.)" >&2
    return 1
  fi

  # 2b. Clean merge: push fork -> main.
  echo "piclaude land: push -a $(basename "$fork") -> $main" >&2
  _pijul_retry push --all --no-notify "$main" || return 1

  echo "" >&2
  echo "  >>> Landed on main: $main" >&2
  echo "  >>> Build & test the executable THERE (cd $main) — the single test point." >&2
  echo "  >>> The landed change is in main's channel. If main's working copy of a" >&2
  echo "  >>> file you landed still shows the old text, materialise ONLY that file:" >&2
  echo "  >>>   pijul reset ${files[*]:-<file>…}" >&2
  echo "  >>> NEVER a bare 'pijul reset' in main: that drops the human's pending" >&2
  echo "  >>> patch (unrecorded work in OTHER files). Pending patches are a" >&2
  echo "  >>> feature — reset by name, never wholesale." >&2
}

cmd_integrate() {
  local pijul root; pijul=$(resolve_pijul); root=$(repo_root)
  local forks=("$@")
  if [ ${#forks[@]} -eq 0 ]; then
    local parent="$(dirname "$root")/$(basename "$root").agents"
    [ -d "$parent" ] || { echo "piclaude: no $parent" >&2; return 1; }
    forks=("$parent"/*)
  fi
  local fork tries out
  for fork in "${forks[@]}"; do
    [ -d "$fork/.pijul" ] || continue
    echo "piclaude integrate: <- $(basename "$fork")" >&2
    tries=0
    while :; do
      if out=$("$pijul" pull --all "$fork" 2>&1); then [ -n "$out" ] && echo "$out"; break; fi
      if printf '%s' "$out" | grep -qi lock; then
        tries=$((tries+1)); [ $tries -ge 200 ] && { echo "give up (locked): $fork" >&2; return 1; }
        sleep 0.05; continue
      fi
      echo "$out" >&2; return 1
    done
  done
  if grep -rIlE '^>>>>>>>|^<<<<<<<' "$root" 2>/dev/null | grep -qv '/\.pijul/'; then
    echo "piclaude: CONFLITS — résous les marqueurs puis 'pijul record -a -m resolve'" >&2
  else
    echo "piclaude: intégration propre" >&2
  fi
}

cmd_status() {
  # A supervision dashboard for all forks of the current repo: each agent's
  # state (the breadcrumb piclaude-notify writes) plus whether it has work to
  # land (an unrecorded pending diff, and/or recorded changes not yet on main).
  local pijul root; pijul=$(resolve_pijul); root=$(repo_root) || return 1
  # If we're inside a fork, the sibling forks live one level up from the repo.
  local main parent
  case "$(dirname "$root")" in
    *.agents) main="$(dirname "$root")"; main="${main%.agents}" ;;
    *)        main="$root" ;;
  esac
  parent="$(dirname "$main")/$(basename "$main").agents"
  [ -d "$parent" ] || { echo "piclaude: no forks yet ($parent)" >&2; return 0; }

  # main's change set, to measure how far ahead each fork is.
  local mainlog; mainlog=$("$pijul" log --repository "$main" --hash-only 2>/dev/null | sort || true)

  printf '%-24s  %-8s  %-8s  %s\n' FORK STATE PENDING AHEAD
  local fork name state pending ahead
  for fork in "$parent"/*; do
    [ -d "$fork/.pijul" ] || continue
    name=$(basename "$fork")
    state=$(cat "$fork/.pijul/piclaude-state" 2>/dev/null || echo '—')
    # pending = uncommitted working-copy changes (something to record).
    if [ -n "$("$pijul" diff --repository "$fork" --output-format json 2>/dev/null | tr -d '[:space:]' | sed 's/{}//')" ]; then
      pending=yes; else pending=no; fi
    # ahead = recorded changes present in the fork but not on main.
    ahead=$(comm -23 <("$pijul" log --repository "$fork" --hash-only 2>/dev/null | sort) <(printf '%s\n' "$mainlog") 2>/dev/null | grep -c . | tr -d ' ' || true)
    printf '%-24s  %-8s  %-8s  %s\n' "$name" "$state" "$pending" "$ahead"
  done
}

cmd_doctor() {
  local pijul; pijul=$(resolve_pijul) && echo "pijul:  $pijul (--from-change OK)"
  echo "editor: ${VISUAL:-${EDITOR:-<unset>}}"
  if can_edit_here; then echo "carve here: yes"; else echo "carve here: no (use '! piclaude carve')"; fi
}

case "${1:-new}" in
  new)       shift || true; cmd_new "$@" ;;   # bare `piclaude`: no arg to shift
  fork)      shift; cmd_fork "${1:-}" ;;
  save)      shift; cmd_save "$@" ;;
  carve)     shift; cmd_carve "$@" ;;
  land)      shift; cmd_land "$@" ;;
  integrate) shift; cmd_integrate "$@" ;;
  status)    cmd_status ;;
  doctor)    cmd_doctor ;;
  -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  # `piclaude [name] [claude flags…]` or `piclaude --resume ID` (flags forwarded)
  *)         cmd_new "$@" ;;
esac
